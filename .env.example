# Copiar a .env y completar. El archivo .env NO se versiona.
#
# Los nombres de abajo son los que el codigo lee de verdad. La version anterior declaraba
# JWT_ISSUER, JWT_AUDIENCE_STAFF y JWT_AUDIENCE_GUEST, que ninguna propiedad consulta y que
# describen un diseno de dos app registrations abandonado en la decision D3 del 2026-09-14.
# Hay un solo tenant y una sola aplicacion: ver infra/docs/idaas/tenants.md.

# --- Identidad (Entra ID). No son secretos: son identificadores publicos del App Registration ---
AZURE_TENANT_ID=055d11d1-8ae0-4221-a6f7-b50be0a623b4
AZURE_CLIENT_ID=704a544f-3d92-44f5-aef9-8559574cff34

# --- Microservicios de dominio. Los nombres anteriores (SVC_*_URL) no los lee nadie,
#     y el de report apuntaba al 8085 cuando el servicio escucha en el 8083 ---
RESERVATIONS_URL=http://localhost:8081
CATALOG_URL=http://localhost:8082
REPORT_URL=http://localhost:8083
AUDIT_URL=http://localhost:8084

# --- Origen exacto desde el que el navegador carga la SPA. Sin comodines ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Copiar a .env y completar. El archivo .env NO se versiona.
# Los valores salen de docs/guias/azure-identidad.md, parte C, en el repositorio infra.

SERVER_PORT=8080

# --- Emisor de identidad ---
# El personal y los huespedes comparten tenant, asi que comparten issuer, pero cada grupo
# tiene su propia app registration y por lo tanto su propia audience.
JWT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
JWT_AUDIENCE_STAFF=api://<staff-client-id>
JWT_AUDIENCE_GUEST=api://<guest-client-id>

# --- Microservicios de dominio ---
SVC_RESERVATIONS_URL=http://localhost:8081
SVC_CATALOG_URL=http://localhost:8082
SVC_AUDIT_URL=http://localhost:8084
SVC_REPORT_URL=http://localhost:8085

# Subir a DEBUG para ver por que un token fue rechazado
LOG_LEVEL_SECURITY=INFO
